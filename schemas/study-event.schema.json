{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aion.school.local/schemas/v1/study-event.schema.json",
  "title": "AION study-event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "SESSION_STARTED",
        "INTERACTION_RECORDED",
        "PAUSE_DECLARED",
        "SESSION_RESUMED",
        "SESSION_CLOSED",
        "OFFLINE_TIME_DECLARED",
        "ESTIMATE_CORRECTED"
      ]
    },
    "origin": {
      "enum": [
        "HUMAN",
        "CHAT"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      },
      "required": [
        "source_ref"
      ]
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "competency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      },
      "required": []
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "timestamp",
    "type",
    "origin",
    "provenance",
    "data"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "SESSION_STARTED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activation": {
              "const": "Pez en el agua"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "area": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "activity_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "tutor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "mode": {
              "enum": [
                "MANUAL",
                "CHAT_ESTIMADO",
                "DECLARADO"
              ]
            },
            "timed_task": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "task_brief_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "time_declared": {
                  "const": true
                },
                "authorized_fields": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "active_minutes",
                      "started_at",
                      "ended_at",
                      "pauses",
                      "mode",
                      "confidence"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "task_id",
                "task_brief_ref",
                "time_declared",
                "authorized_fields"
              ]
            }
          },
          "required": [
            "activation",
            "timezone",
            "area",
            "activity_type",
            "mode"
          ]
        },
        "origin": {
          "const": "HUMAN"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "INTERACTION_RECORDED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "PAUSE_DECLARED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "origin": {
          "const": "HUMAN"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "SESSION_RESUMED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "origin": {
          "const": "HUMAN"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "SESSION_CLOSED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "origin": {
          "const": "HUMAN"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "OFFLINE_TIME_DECLARED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "ended_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "started_at",
            "ended_at"
          ]
        },
        "origin": {
          "const": "HUMAN"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ESTIMATE_CORRECTED"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "const": "active_minutes"
            },
            "previous_minutes": {
              "type": "number",
              "minimum": 0
            },
            "new_minutes": {
              "type": "number",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            }
          },
          "required": [
            "target",
            "previous_minutes",
            "new_minutes",
            "reason"
          ]
        },
        "origin": {
          "const": "HUMAN"
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ]
}
